meta {
  name: 1 - Sign In
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/user/sign-in
  body: json
  auth: none
}

body:json {
  {
    "identifier": "gtiofandy@gmail.com",
    "password": "asdf1234"
  }
}

script:post-response {
  const body = res.getBody();
  
  test("sign-in successful", function () {
    expect(res.getStatus()).to.equal(200);
    expect(body.data.token).to.be.a("string");
  });
  bru.setEnvVar("token", body.data.token);
}
